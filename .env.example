# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
MONGO_USER=hms_admin
MONGO_PASSWORD=change-me
MONGO_DB=hms
JWT_SECRET=change-me-to-a-64-char-random-string
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@yourhospital.com
ADMIN_PASSWORD=ChangeMe@2026
TZ=Asia/Kolkata
WEB_PORT=8095
COOKIE_SECURE=true
# Demo: SEED_DEMO loads sample data once; DEMO_MODE shows demo logins on the sign-in page.
SEED_DEMO=true
DEMO_MODE=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
# Optional gateways (messages are logged when not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_SENDER_ID=HOSPTL
